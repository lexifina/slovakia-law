\ltrch\fcs0 \insrsid919037 (2)}{\rtlch\fcs1 \af1 \ltrch\fcs0 \insrsid3422520 \~}{\rtlch\fcs1 \af1 \ltrch\fcs0 \insrsid919037 Zvl\'e1\'9atny odpad je odpad, ktor\'fd vy\'9eaduje osobitn\'fd re\'9eim pri nakladan\'ed s n\'edm, najm\'e4 z\~n\'e1rodo\-hospod
\'e1rskych d\'f4vodov alebo ochrany \'9eivotn\'e9ho prostredia.
\par (3)}{\rtlch\fcs1 \af1 \ltrch\fcs0 \insrsid3422520 \~}{\rtlch\fcs1 \af1 \ltrch\fcs0 \insrsid919037 Nebezpe\'e8n\'fd odpad je zvl\'e1\'9atny odpad (odsek 2), ktor\'fd svojimi vlastnos\'9dami najm\'e4 toxicitou, infek\'e8nos\'9dou, dr\'e1\'9edivos\'9dou, v
\'fdbu\'9anos\'9dou, hor\'beavos\'9dou, chemick\'fdmi vlastnos\'9dami, karcinog\'e9nnymi, teratog\'e9nnymi a mutag\'e9nnymi vlastnos\'9dami je alebo m\'f4\'9ee by\'9d nebezpe\'e8n\'fd pre zdravie obyvate\'bestva alebo \'9eivotn\'e9 prostredie.
\par (4)}{\rtlch\fcs1 \af1 \ltrch\fcs0 \insrsid3422520 \~}{\rtlch\fcs1 \af1 \ltrch\fcs0 \insrsid919037 Probl\'e9mov\'e9 l\'e1tky s\'fa nebezpe\'e8n\'e9 odpady, ktor\'e9 s\'fa pr\'edtomn\'e9 v komun\'e1lnom odpade alebo odpady, ktor\'e9 v\'fdrazne zni\'9euj\'fa
 mo\'9enos\'9d vyu\'9e\'edvania komun\'e1lneho odpadu.
\par (5)}{\rtlch\fcs1 \af1 \ltrch\fcs0 \insrsid3422520 \~}{\rtlch\fcs1 \af1 \ltrch\fcs0 \insrsid919037 Druhotnou surovinou je surovina alebo materi\'e1l z\'edskan\'fd z odpadu, ktor\'fd je sp\'f4sobil\'fd na\~\'efal\'9aie hospod\'e1rske alebo in\'e9 vyu\'9e
itie, zost\'e1va pritom odpadom a\'9e do \'efal\'9aieho spracovania.
\par (6)}{\rtlch\fcs1 \af1 \ltrch\fcs0 \insrsid3422520 \~}{\rtlch\fcs1 \af1 \ltrch\fcs0 \insrsid919037 Nakladan\'edm s komun\'e1lnym odpadom je ak\'e1ko\'bevek \'e8innos\'9d, ktorej predmetom je komun\'e1lny odpad, najm\'e4 zhroma\'9e\'ef
ovanie, preprava, skladovanie a zne\'9akod\'f2ovanie komun\'e1lneho odpadu, vr\'e1tane starostlivosti o miesto zne\'9akod\'f2ovania, zber, v\'fdkup, \'faprava, triedenie, spracovanie a\~vyu\'9e\'edvanie komun\'e1lneho odpadu ako zdroja druhotn\'fdch surov
\'edn a\~energie.
\par (7)}{\rtlch\fcs1 \af1 \ltrch\fcs0 \insrsid3422520 \~}{\rtlch\fcs1 \af1 \ltrch\fcs0 \insrsid919037 Separovan\'fd zber je triedenie odpadu na jednotliv\'e9 zlo\'9eky, zber, zvoz, spracovanie a\~vyu\'9e\'edvanie jednotliv\'fdch vytrieden\'fdch zlo\'9eiek.

\par (8)}{\rtlch\fcs1 \af1 \ltrch\fcs0 \insrsid3422520 \~}{\rtlch\fcs1 \af1 \ltrch\fcs0 \insrsid919037 Zlo\'9eky komun\'e1lneho odpadu s\'fa odpady, ktor\'e9 sa z\'edskaj\'fa odde\'beovan\'edm z domov\'e9ho a\~objemn\'e9ho odpadu v mieste vzniku, pri\'e8om m
\'f4\'9eu ma\'9d charakter:
