\par (3)}{\insrsid6758422 \~}{\insrsid6296447 Vykon\'e1vate\'be rozkop\'e1vky ozna\'e8\'ed rozkop\'e1vku, ktorej trvanie sa predpoklad\'e1 viac ako 20 dn\'ed tabu\'beou s uveden\'edm n\'e1zvu a telef\'f3nn\'e9ho \'e8\'edsla vykon\'e1vate\'bea rozkop\'e1vky, za
\'e8atia a\~ukon\'e8enia v\'fdkopov\'fdch pr\'e1c a mena zodpovedn\'e9ho pracovn\'edka.
\par (4)}{\insrsid6758422 \~}{\insrsid6296447 Pri realiz\'e1cii rozkop\'e1vok nie je dovolen\'e9 uklada\'9d vykopan\'fd materi\'e1l vo\'bene lo\'9een\'fd na\~verejnom priestranstve.
\par (5)}{\insrsid6758422 \~}{\insrsid6296447 Vykon\'e1vate\'be rozkop\'e1vky je povinn\'fd vykona\'9d z\'e1syp rozkop\'e1vky vhodn\'fdm nenam\'e0zav\'fdm materi\'e1lom s dobrou mo\'9enos\'9dou zhut\'f2ovania. Vykopan\'fd materi\'e1l mo\'9eno pou\'9ei\'9d n}{
\insrsid1786818 a sp\'e4tn\'fd z\'e1syp rozkop\'e1vky iba s\~}{\insrsid6296447 osobitn\'fdm s\'fahlasom vlastn\'edka alebo spr\'e1vcu verejn\'e9ho priestranstva.
\par (6)}{\insrsid6758422 \~}{\insrsid6296447 Ak tomu nebr\'e1nia ustanovenia in\'fdch predpisov alebo v\'e1\'9ene technick\'e9 probl\'e9my, \'e8i ne\'famerne vysok\'e9 finan\'e8n\'e9 n\'e1klady, ukladaj\'fa sa vedenia in\'9einiersk\'fdch siet\'ed do 
