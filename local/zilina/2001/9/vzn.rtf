\par {\listtext\pard\plain\ltrpar \rtlch\fcs1 \af0 \ltrch\fcs0 \lang1051\langfe1029\langfenp1029 \hich\af0\dbch\af0\loch\f0 b)\tab}pr\'e1vnick\'e1 osoba, alebo fyzick\'e1 osoba - podnikate\'be, pri \'e8innosti ktorej vznikaj\'fa komun\'e1lne odpady, alebo ktor
