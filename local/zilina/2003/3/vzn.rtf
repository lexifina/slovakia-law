\jclisttab\tx2340\wrapdefault\aspalpha\aspnum\faauto\ls14\ilvl2\adjustright\rin0\lin1440\itap0\pararsid13582895 {\rtlch\fcs1 \af0 \ltrch\fcs0 \insrsid13582895 oboznamuj\'fa ob\'e8anov vo svojich obvodoch s\~rozhodnutiami a\~uzneseniami mesta a\~z\'ed
