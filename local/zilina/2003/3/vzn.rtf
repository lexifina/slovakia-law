\par {\listtext\pard\plain\ltrpar \rtlch\fcs1 \af0 \ltrch\fcs0 \lang1051\langfe1029\langfenp1029 \hich\af0\dbch\af0\loch\f0 e)\tab}zvol\'e1vaj\'fa zhroma\'9edenia obyvate\'beov mestskej \'e8asti,
