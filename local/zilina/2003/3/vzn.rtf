\par {\listtext\pard\plain\ltrpar \rtlch\fcs1 \af0 \ltrch\fcs0 \lang1051\langfe1029\langfenp1029 \hich\af0\dbch\af0\loch\f0 h)\tab}vz\'e1jomne spolupracuj\'fa s\~ostatn\'fdmi v\'fdbormi pri zabezpe\'e8ovan\'ed \'faloh, ktor\'e9 presahuj\'fa r\'e1
