\par {\listtext\pard\plain\ltrpar \rtlch\fcs1 \af0 \ltrch\fcs0 \lang1051\langfe1029\langfenp1029 \hich\af0\dbch\af0\loch\f0 g)\tab}spolupracuj\'fa s\~politick\'fdmi stranami a\~hnutiami, vyv\'edjaj\'facimi \'e8innos\'9d v\~mestsk\'fdch \'e8astiach, ako aj so z
